{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [["\"", "\""]],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [["\"", "\""]],
  "wordPattern": "([A-Za-z0-9_\\-.]+)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*$",
    "decreaseIndentPattern": "^\\s*$"
  }
}
