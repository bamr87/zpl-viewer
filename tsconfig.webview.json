{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "bwip-js": ["node_modules/bwip-js/dist/bwip-js.d.ts"]
    }
  },
  "include": [
    "src/webview/**/*",
    "src/renderer/**/*",
    "src/core/**/*",
    "src/barcode/**/*",
    "src/formats/**/*",
    "src/data/**/*",
    "src/emit/**/*",
    "src/analysis/**/*",
    "src/zplParser.ts",
    "src/formatting.ts"
  ]
}
