{
  "name": "zpl-viewer",
  "displayName": "Label Studio — Labels, Barcodes & Data",
  "description": "Read, create, analyze, import, merge and deploy thermal labels: ZPL II and EPL2 language support, live preview, a barcode studio for 24 symbologies, CSV/JSON data merge, and printer deployment — all offline.",
  "version": "0.2.0",
  "publisher": "zpl-viewer",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Linters",
    "Visualization",
    "Data Science"
  ],
  "keywords": [
    "zpl",
    "epl",
    "zebra",
    "label",
    "printer",
    "barcode",
    "qr",
    "gs1",
    "thermal",
    "labelary"
  ],
  "activationEvents": [
    "onLanguage:zpl",
    "onLanguage:epl"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bamr87/zpl-viewer"
  },
  "contributes": {
    "languages": [
      {
        "id": "zpl",
        "aliases": [
          "ZPL",
          "Zebra Programming Language",
          "zpl"
        ],
        "extensions": [
          ".zpl",
          ".zpl2",
          ".prn",
          ".lbl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        }
      },
      {
        "id": "epl",
        "aliases": [
          "EPL",
          "EPL2",
          "Eltron Programming Language"
        ],
        "extensions": [
          ".epl",
          ".epl2"
        ],
        "configuration": "./language-configuration-epl.json",
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "zpl",
        "scopeName": "source.zpl",
        "path": "./syntaxes/zpl.tmLanguage.json"
      },
      {
        "language": "epl",
        "scopeName": "source.epl",
        "path": "./syntaxes/epl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zpl",
        "path": "./snippets/zpl.code-snippets"
      },
      {
        "language": "epl",
        "path": "./snippets/epl.code-snippets"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "labelStudio",
          "title": "Label Studio",
          "icon": "images/activity-icon.svg"
        }
      ]
    },
    "views": {
      "labelStudio": [
        {
          "id": "labelStudio.labelsView",
          "name": "Labels",
          "icon": "images/activity-icon.svg"
        },
        {
          "id": "labelStudio.dataView",
          "name": "Data sources",
          "icon": "images/activity-icon.svg"
        },
        {
          "id": "labelStudio.printersView",
          "name": "Printers",
          "icon": "images/activity-icon.svg"
        },
        {
          "id": "labelStudio.templatesView",
          "name": "Templates",
          "icon": "images/activity-icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "labelStudio.printersView",
        "contents": "No printers configured.\n[Add a printer](command:labelStudio.addPrinter)\nPrinters can be a network address, a device path, or a spool folder."
      },
      {
        "view": "labelStudio.labelsView",
        "contents": "No label files found in this workspace.\n[New label from template](command:labelStudio.newFromTemplate)\n[Import a printer capture](command:labelStudio.importCapture)"
      }
    ],
    "commands": [
      {
        "command": "labelStudio.preview",
        "title": "Open Label Preview",
        "category": "Label",
        "icon": "$(open-preview)"
      },
      {
        "command": "labelStudio.previewToSide",
        "title": "Open Label Preview to the Side",
        "category": "Label",
        "icon": "$(open-preview)"
      },
      {
        "command": "labelStudio.refreshPreview",
        "title": "Refresh Preview",
        "category": "Label",
        "icon": "$(refresh)"
      },
      {
        "command": "labelStudio.exportPng",
        "title": "Export Label as PNG",
        "category": "Label"
      },
      {
        "command": "labelStudio.exportPdf",
        "title": "Export Labels as PDF",
        "category": "Label"
      },
      {
        "command": "labelStudio.formatDocument",
        "title": "Format Label Document",
        "category": "Label"
      },
      {
        "command": "labelStudio.validate",
        "title": "Validate Label",
        "category": "Label"
      },
      {
        "command": "labelStudio.analyze",
        "title": "Analyze Label (metrics + findings)",
        "category": "Label",
        "icon": "$(graph)"
      },
      {
        "command": "labelStudio.insertTemplate",
        "title": "Insert Label Snippet",
        "category": "Label"
      },
      {
        "command": "labelStudio.newFromTemplate",
        "title": "New Label from Template",
        "category": "Label",
        "icon": "$(new-file)"
      },
      {
        "command": "labelStudio.convertFormat",
        "title": "Convert Label to Another Printer Language",
        "category": "Label"
      },
      {
        "command": "labelStudio.openBarcodeStudio",
        "title": "Open Barcode Studio",
        "category": "Label",
        "icon": "$(symbol-color)"
      },
      {
        "command": "labelStudio.insertBarcode",
        "title": "Insert Barcode Field",
        "category": "Label"
      },
      {
        "command": "labelStudio.importImage",
        "title": "Import Image as Label Graphic",
        "category": "Label"
      },
      {
        "command": "labelStudio.importCapture",
        "title": "Import Printer Capture",
        "category": "Label"
      },
      {
        "command": "labelStudio.previewDataSource",
        "title": "Preview Data Source",
        "category": "Label"
      },
      {
        "command": "labelStudio.mergeData",
        "title": "Merge Data Into Labels",
        "category": "Label",
        "icon": "$(run-all)"
      },
      {
        "command": "labelStudio.checkMapping",
        "title": "Check Data Mapping",
        "category": "Label"
      },
      {
        "command": "labelStudio.deploy",
        "title": "Deploy Label to Printer",
        "category": "Label",
        "icon": "$(rocket)"
      },
      {
        "command": "labelStudio.deployDryRun",
        "title": "Deploy Label (dry run)",
        "category": "Label"
      },
      {
        "command": "labelStudio.addPrinter",
        "title": "Add Printer",
        "category": "Label",
        "icon": "$(add)"
      },
      {
        "command": "labelStudio.refreshExplorer",
        "title": "Refresh Label Explorer",
        "category": "Label",
        "icon": "$(refresh)"
      },
      {
        "command": "labelStudio.showOutput",
        "title": "Show Deployment Log",
        "category": "Label"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "labelStudio.newFromTemplate",
          "when": "view == labelStudio.labelsView",
          "group": "navigation@1"
        },
        {
          "command": "labelStudio.refreshExplorer",
          "when": "view == labelStudio.labelsView",
          "group": "navigation@2"
        },
        {
          "command": "labelStudio.refreshExplorer",
          "when": "view == labelStudio.dataView",
          "group": "navigation@1"
        },
        {
          "command": "labelStudio.addPrinter",
          "when": "view == labelStudio.printersView",
          "group": "navigation@1"
        },
        {
          "command": "labelStudio.refreshExplorer",
          "when": "view == labelStudio.printersView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "labelStudio.previewDataSource",
          "when": "view == labelStudio.dataView && viewItem == dataSource",
          "group": "labelStudio@1"
        },
        {
          "command": "labelStudio.mergeData",
          "when": "view == labelStudio.dataView && viewItem == dataSource",
          "group": "labelStudio@2"
        },
        {
          "command": "labelStudio.checkMapping",
          "when": "view == labelStudio.dataView && viewItem == dataSource",
          "group": "labelStudio@3"
        },
        {
          "command": "labelStudio.deploy",
          "when": "view == labelStudio.printersView && viewItem == printer",
          "group": "labelStudio@1"
        },
        {
          "command": "labelStudio.deployDryRun",
          "when": "view == labelStudio.printersView && viewItem == printer",
          "group": "labelStudio@2"
        }
      ],
      "editor/title": [
        {
          "when": "resourceLangId == zpl || resourceLangId == epl",
          "command": "labelStudio.previewToSide",
          "group": "navigation@1"
        },
        {
          "when": "resourceLangId == zpl || resourceLangId == epl",
          "command": "labelStudio.analyze",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "when": "resourceLangId == zpl || resourceLangId == epl",
          "command": "labelStudio.preview",
          "group": "labelStudio@1"
        },
        {
          "when": "resourceLangId == zpl || resourceLangId == epl",
          "command": "labelStudio.insertBarcode",
          "group": "labelStudio@2"
        },
        {
          "when": "resourceLangId == zpl || resourceLangId == epl",
          "command": "labelStudio.mergeData",
          "group": "labelStudio@3"
        },
        {
          "when": "resourceLangId == zpl || resourceLangId == epl",
          "command": "labelStudio.deploy",
          "group": "labelStudio@4"
        },
        {
          "when": "resourceLangId == zpl || resourceLangId == epl",
          "command": "labelStudio.formatDocument",
          "group": "labelStudio@5"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId == zpl || resourceLangId == epl",
          "command": "labelStudio.preview",
          "group": "labelStudio@1"
        },
        {
          "when": "resourceLangId == zpl || resourceLangId == epl",
          "command": "labelStudio.analyze",
          "group": "labelStudio@2"
        },
        {
          "when": "resourceExtname == .csv || resourceExtname == .tsv || resourceExtname == .json || resourceExtname == .jsonl",
          "command": "labelStudio.previewDataSource",
          "group": "labelStudio@3"
        },
        {
          "when": "resourceExtname == .csv || resourceExtname == .tsv || resourceExtname == .json || resourceExtname == .jsonl",
          "command": "labelStudio.mergeData",
          "group": "labelStudio@4"
        }
      ],
      "commandPalette": [
        {
          "command": "labelStudio.preview",
          "when": "resourceLangId == zpl || resourceLangId == epl"
        },
        {
          "command": "labelStudio.previewToSide",
          "when": "resourceLangId == zpl || resourceLangId == epl"
        },
        {
          "command": "labelStudio.refreshPreview",
          "when": "resourceLangId == zpl || resourceLangId == epl"
        },
        {
          "command": "labelStudio.exportPng",
          "when": "resourceLangId == zpl || resourceLangId == epl"
        },
        {
          "command": "labelStudio.exportPdf",
          "when": "resourceLangId == zpl || resourceLangId == epl"
        },
        {
          "command": "labelStudio.formatDocument",
          "when": "resourceLangId == zpl || resourceLangId == epl"
        },
        {
          "command": "labelStudio.validate",
          "when": "resourceLangId == zpl || resourceLangId == epl"
        },
        {
          "command": "labelStudio.analyze",
          "when": "resourceLangId == zpl || resourceLangId == epl"
        },
        {
          "command": "labelStudio.insertTemplate",
          "when": "resourceLangId == zpl || resourceLangId == epl"
        },
        {
          "command": "labelStudio.insertBarcode",
          "when": "resourceLangId == zpl || resourceLangId == epl"
        },
        {
          "command": "labelStudio.convertFormat",
          "when": "resourceLangId == zpl || resourceLangId == epl"
        },
        {
          "command": "labelStudio.mergeData",
          "when": "resourceLangId == zpl || resourceLangId == epl"
        },
        {
          "command": "labelStudio.checkMapping",
          "when": "resourceLangId == zpl || resourceLangId == epl"
        },
        {
          "command": "labelStudio.deploy",
          "when": "resourceLangId == zpl || resourceLangId == epl"
        },
        {
          "command": "labelStudio.deployDryRun",
          "when": "resourceLangId == zpl || resourceLangId == epl"
        }
      ]
    },
    "keybindings": [
      {
        "command": "labelStudio.previewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == zpl || editorLangId == epl"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Label Studio",
      "properties": {
        "labelStudio.defaultFormat": {
          "type": "string",
          "enum": [
            "auto",
            "zpl",
            "epl"
          ],
          "default": "auto",
          "description": "Printer language assumed for files that do not declare one (.prn, .lbl). `auto` sniffs the content."
        },
        "labelStudio.renderer.density": {
          "type": "string",
          "enum": [
            "6dpmm",
            "8dpmm",
            "12dpmm",
            "24dpmm"
          ],
          "default": "8dpmm",
          "description": "Print density used when rendering labels. Matches the target printer's resolution."
        },
        "labelStudio.label.widthInches": {
          "type": "number",
          "default": 4,
          "minimum": 0.25,
          "maximum": 15,
          "description": "Label width in inches."
        },
        "labelStudio.label.heightInches": {
          "type": "number",
          "default": 6,
          "minimum": 0.25,
          "maximum": 30,
          "description": "Label height in inches."
        },
        "labelStudio.preview.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh the preview as the document changes."
        },
        "labelStudio.preview.autoRefreshDelay": {
          "type": "number",
          "default": 400,
          "minimum": 100,
          "maximum": 5000,
          "description": "Debounce delay (ms) for preview auto-refresh."
        },
        "labelStudio.preview.initialZoom": {
          "type": "number",
          "default": 2,
          "minimum": 0.25,
          "maximum": 8,
          "description": "Initial display scale for the preview (1 = 1 dot per pixel)."
        },
        "labelStudio.format.uppercaseCommands": {
          "type": "boolean",
          "default": true,
          "description": "Uppercase ZPL commands when formatting. EPL command case is significant and is never changed."
        },
        "labelStudio.format.oneCommandPerLine": {
          "type": "boolean",
          "default": true,
          "description": "Place each ZPL command on its own line when formatting."
        },
        "labelStudio.validation.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable diagnostics for label documents."
        },
        "labelStudio.validation.barcodeData": {
          "type": "boolean",
          "default": true,
          "description": "Check barcode payloads against the symbology's character set, length and check digit."
        },
        "labelStudio.validation.bounds": {
          "type": "boolean",
          "default": true,
          "description": "Report fields that fall outside the printable area."
        },
        "labelStudio.validation.scannability": {
          "type": "boolean",
          "default": true,
          "description": "Report bar widths, bar heights and quiet zones that are likely to fail a scanner."
        },
        "labelStudio.merge.maxRows": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "maximum": 100000,
          "description": "Maximum number of data rows expanded by a single merge."
        },
        "labelStudio.import.threshold": {
          "type": "number",
          "default": 128,
          "minimum": 1,
          "maximum": 254,
          "description": "Luminance threshold (0-255) below which an imported image pixel becomes a printed dot."
        },
        "labelStudio.import.dither": {
          "type": "string",
          "enum": [
            "none",
            "floyd-steinberg"
          ],
          "default": "none",
          "description": "Dithering applied when converting imported artwork to 1 bit per pixel. Use `none` for logos and line art."
        },
        "labelStudio.import.maxWidthDots": {
          "type": "number",
          "default": 600,
          "minimum": 8,
          "maximum": 4000,
          "description": "Imported images wider than this many dots are scaled down to fit."
        },
        "labelStudio.deploy.confirmBeforeSend": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before sending a label to a printer."
        },
        "labelStudio.deploy.timeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 500,
          "maximum": 120000,
          "description": "How long to wait for a network printer before giving up."
        },
        "labelStudio.printers": {
          "type": "array",
          "default": [],
          "description": "Printers labels can be deployed to.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name, e.g. `Warehouse ZT411`."
              },
              "transport": {
                "type": "string",
                "enum": [
                  "tcp",
                  "file",
                  "directory"
                ],
                "default": "tcp",
                "description": "`tcp` sends to a network printer, `file` writes to a device or share, `directory` drops a spool file."
              },
              "host": {
                "type": "string",
                "description": "Hostname or IP address (tcp transport)."
              },
              "port": {
                "type": "number",
                "default": 9100,
                "description": "TCP port; raw printing is 9100 on virtually every printer."
              },
              "path": {
                "type": "string",
                "description": "Device path, share or spool directory (file/directory transports)."
              },
              "format": {
                "type": "string",
                "enum": [
                  "zpl",
                  "epl"
                ],
                "default": "zpl",
                "description": "Printer language. Labels written in the other language are converted on deploy."
              },
              "dpmm": {
                "type": "number",
                "enum": [
                  6,
                  8,
                  12,
                  24
                ],
                "default": 8,
                "description": "Print density in dots per millimetre."
              },
              "widthInches": {
                "type": "number",
                "description": "Stock width in inches."
              },
              "heightInches": {
                "type": "number",
                "description": "Stock height in inches."
              },
              "append": {
                "type": "boolean",
                "default": false,
                "description": "Append to the target file instead of replacing it (file transport)."
              },
              "description": {
                "type": "string",
                "description": "Free-text note shown in the printers view."
              }
            }
          }
        },
        "zplViewer.renderer.density": {
          "type": "string",
          "enum": [
            "6dpmm",
            "8dpmm",
            "12dpmm",
            "24dpmm"
          ],
          "default": "8dpmm",
          "deprecationMessage": "Renamed to labelStudio.renderer.density.",
          "description": "Deprecated: use `labelStudio.renderer.density`."
        },
        "zplViewer.label.widthInches": {
          "type": "number",
          "default": 4,
          "deprecationMessage": "Renamed to labelStudio.label.widthInches.",
          "description": "Deprecated: use `labelStudio.label.widthInches`."
        },
        "zplViewer.label.heightInches": {
          "type": "number",
          "default": 6,
          "deprecationMessage": "Renamed to labelStudio.label.heightInches.",
          "description": "Deprecated: use `labelStudio.label.heightInches`."
        },
        "zplViewer.preview.autoRefresh": {
          "type": "boolean",
          "default": true,
          "deprecationMessage": "Renamed to labelStudio.preview.autoRefresh.",
          "description": "Deprecated: use `labelStudio.preview.autoRefresh`."
        },
        "zplViewer.preview.autoRefreshDelay": {
          "type": "number",
          "default": 400,
          "deprecationMessage": "Renamed to labelStudio.preview.autoRefreshDelay.",
          "description": "Deprecated: use `labelStudio.preview.autoRefreshDelay`."
        },
        "zplViewer.preview.initialZoom": {
          "type": "number",
          "default": 2,
          "deprecationMessage": "Renamed to labelStudio.preview.initialZoom.",
          "description": "Deprecated: use `labelStudio.preview.initialZoom`."
        },
        "zplViewer.format.uppercaseCommands": {
          "type": "boolean",
          "default": true,
          "deprecationMessage": "Renamed to labelStudio.format.uppercaseCommands.",
          "description": "Deprecated: use `labelStudio.format.uppercaseCommands`."
        },
        "zplViewer.format.oneCommandPerLine": {
          "type": "boolean",
          "default": true,
          "deprecationMessage": "Renamed to labelStudio.format.oneCommandPerLine.",
          "description": "Deprecated: use `labelStudio.format.oneCommandPerLine`."
        },
        "zplViewer.validation.enable": {
          "type": "boolean",
          "default": true,
          "deprecationMessage": "Renamed to labelStudio.validation.enable.",
          "description": "Deprecated: use `labelStudio.validation.enable`."
        }
      }
    },
    "configurationDefaults": {
      "[zpl]": {
        "editor.wordWrap": "on",
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "[epl]": {
        "editor.wordWrap": "off",
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p ./tsconfig.test.json --outDir out",
    "watch-tests": "tsc -p ./tsconfig.test.json -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test:unit": "npm run compile-tests && c8 --all --include=src/**/*.ts --exclude=src/test/** mocha \"out/test/unit/**/*.test.js\" \"out/test/renderer/draw.test.js\"",
    "test:visual": "npm run compile-tests && mocha \"out/test/renderer/visual/**/*.test.js\"",
    "test:visual:update": "cross-env UPDATE_GOLDENS=1 npm run test:visual",
    "test:integration": "npm run compile-tests && cross-env VSCODE_ZPL_TEST=1 node ./out/test/runTest.js",
    "test:e2e": "playwright test -c src/test/e2e/playwright.config.ts",
    "test": "npm run test:unit && npm run test:visual && npm run test:integration && npm run test:e2e"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.99",
    "@playwright/test": "^1.59.1",
    "@types/chai": "^5.2.3",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/pngjs": "^6.0.5",
    "@types/sinon": "^21.0.1",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.9",
    "c8": "^11.0.0",
    "chai": "^4.5.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "sinon": "^21.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "bwip-js": "^4.10.1",
    "pdf-lib": "^1.17.1"
  }
}
